# Copy to get.env (gitignored) and add your key from https://aistudio.google.com/apikey
# Never commit get.env — use host env vars in production (e.g. Render).
PORT=5000
GEMINI_SECRET_KEY=
# Or: GEMINI_API_KEY=

# Optional. If unset, tries: gemini-2.5-flash → gemini-1.5-flash → gemini-2.0-flash → gemini-1.5-pro
# GEMINI_MODEL=gemini-2.5-flash

# Abuse limits (palette endpoint only). Tune on your host.
# PALETTE_RATE_LIMIT_WINDOW_MS=900000
# PALETTE_RATE_LIMIT_MAX=30
# MAX_PROMPT_CHARS=8000
# JSON_BODY_LIMIT=32kb
# TRUST_PROXY=1

NODE_ENV=development
